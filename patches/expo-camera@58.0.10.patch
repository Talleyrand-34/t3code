+package expo.modules.camera.analyzers
+
+import android.graphics.ImageFormat
+import android.graphics.Rect
+import androidx.camera.core.ImageInfo
+import androidx.camera.core.ImageProxy
+import androidx.camera.core.impl.TagBundle
+import androidx.camera.core.impl.utils.ExifData
+import java.nio.ByteBuffer
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+
+/**
+ * The camera hands the analyzer a frame, not a picture, so the frame is put together
+ * here the way a camera would.
+ */
+@RunWith(RobolectricTestRunner::class)
+class BarcodeAnalyzerTest {
+  @Test
+  fun `a code in a frame is reported`() {
+    val text = "https://app.t3.codes/pair?code=abc123"
+    val size = 240
+    var reported: expo.modules.camera.utils.BarCodeScannerResult? = null
+    val analyzer = BarcodeAnalyzer(listOf(expo.modules.camera.records.BarcodeType.QR)) {
+      reported = it
+    }
+
+    analyzer.analyze(Frame(qrLuminance(text, size), size, size, size, 0))
+
+    assertEquals(text, reported?.value)
+    assertEquals(BarcodeFormats.QR_CODE, reported?.type)
+  }
+
+  @Test
+  fun `a frame with a wider row is still read`() {
+    val text = "https://app.t3.codes/pair?code=abc123"
+    val size = 240
+    val rowStride = size + 16
+    val padded = ByteArray(rowStride * size)
+    for (row in 0 until size) {
+      System.arraycopy(qrLuminance(text, size), row * size, padded, row * rowStride, size)
+    }
+    var reported: expo.modules.camera.utils.BarCodeScannerResult? = null
+    val analyzer = BarcodeAnalyzer(listOf(expo.modules.camera.records.BarcodeType.QR)) {
+      reported = it
+    }
+
+    analyzer.analyze(Frame(padded, size, size, rowStride, 0))
+
+    assertEquals(text, reported?.value)
+  }
+
+  @Test
+  fun `a frame with no code reports nothing`() {
+    val size = 240
+    var reported: expo.modules.camera.utils.BarCodeScannerResult? = null
+    val analyzer = BarcodeAnalyzer(listOf(expo.modules.camera.records.BarcodeType.QR)) {
+      reported = it
+    }
+
+    analyzer.analyze(Frame(ByteArray(size * size) { 0xFF.toByte() }, size, size, size, 0))
+
+    assertEquals(null, reported)
+  }
+
+  private fun qrLuminance(text: String, size: Int): ByteArray {
+    val matrix =
+        com.google.zxing.qrcode.QRCodeWriter()
+            .encode(text, com.google.zxing.BarcodeFormat.QR_CODE, size, size)
+    val luminance = ByteArray(size * size)
+    for (row in 0 until size) {
+      for (column in 0 until size) {
+        luminance[row * size + column] = if (matrix.get(column, row)) 0 else 0xFF.toByte()
+      }
+    }
+    return luminance
+  }
+
+  /** A frame with one brightness plane, the way a camera hands it over. */
+  private class Frame(
+    private val luminance: ByteArray,
+    private val frameWidth: Int,
+    private val frameHeight: Int,
+    private val frameRowStride: Int,
+    private val frameRotation: Int
+  ) : ImageProxy {
+    private val plane =
+        object : ImageProxy.PlaneProxy {
+          override fun getRowStride(): Int = frameRowStride
+
+          override fun getPixelStride(): Int = 1
+
+          override fun getBuffer(): ByteBuffer = ByteBuffer.wrap(luminance)
+        }
+
+    override fun close() {}
+
+    override fun getCropRect(): Rect = Rect(0, 0, frameWidth, frameHeight)
+
+    override fun setCropRect(cropRect: Rect?) {}
+
+    override fun getFormat(): Int = ImageFormat.YUV_420_888
+
+    override fun getHeight(): Int = frameHeight
+
+    override fun getWidth(): Int = frameWidth
+
+    override fun getPlanes(): Array<ImageProxy.PlaneProxy> = arrayOf(plane)
+
+    override fun getImageInfo(): ImageInfo =
+        object : ImageInfo {
+          override fun getTagBundle(): TagBundle = TagBundle.emptyBundle()
+
+          override fun getTimestamp(): Long = 0
+
+          override fun getRotationDegrees(): Int = frameRotation
+
+          override fun populateExifData(builder: ExifData.Builder) {}
+        }
+
+    override fun getImage(): android.media.Image? = null
+  }
+}
