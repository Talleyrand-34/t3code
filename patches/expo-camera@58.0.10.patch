+package expo.modules.camera.analyzers
+
+import android.graphics.Bitmap
+import com.google.zxing.BarcodeFormat
+import expo.modules.camera.utils.BarCodeScannerResult
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * Scans a picture for barcodes.
+ *
+ * The settings decide which formats are looked for, so a caller that wants only QR
+ * codes never pays for the others.
+ */
+class ZXingBarCodeScanner {
+  private var formats: Set<BarcodeFormat> = emptySet()
+
+  suspend fun scan(bitmap: Bitmap): List<BarCodeScannerResult> = withContext(Dispatchers.IO) {
+    ZXingBarcodeReader(formats).decodeAll(bitmap)
+  }
+
+  fun setSettings(formats: Set<BarcodeFormat>) {
+    this.formats = formats
+  }
+}
diff --git a/android/src/main/java/expo/modules/camera/analyzers/ZXingBarcodeReader.kt b/android/src/main/java/expo/modules/camera/analyzers/ZXingBarcodeReader.kt
new file mode 100644
index 0000000000000000000000000000000000000000..c1614a5200335a3ff20a15a2d6444c4823636a4a
--- /dev/null
+++ b/android/src/main/java/expo/modules/camera/analyzers/ZXingBarcodeReader.kt
@@ -0,0 +1,153 @@
+package expo.modules.camera.analyzers
+
+import android.graphics.Bitmap
+import com.google.zxing.BarcodeFormat
+import com.google.zxing.BinaryBitmap
+import com.google.zxing.DecodeHintType
+import com.google.zxing.MultiFormatReader
+import com.google.zxing.NotFoundException
+import com.google.zxing.PlanarYUVLuminanceSource
+import com.google.zxing.RGBLuminanceSource
+import com.google.zxing.Result
+import com.google.zxing.common.HybridBinarizer
+import expo.modules.camera.utils.BarCodeScannerResult
+
+/**
+ * Decodes barcodes without Google Play Services.
+ *
+ * The reader keeps its state between frames, so every decode holds the lock.
+ */
+class ZXingBarcodeReader(formats: Set<BarcodeFormat>) {
+  private val reader = MultiFormatReader()
+
+  init {
+    val hints = buildMap<DecodeHintType, Any> {
+      if (formats.isNotEmpty()) put(DecodeHintType.POSSIBLE_FORMATS, formats)
+      put(DecodeHintType.TRY_HARDER, true)
+    }
+    reader.setHints(hints)
+  }
+
+  /**
+   * Decodes the brightness plane of a camera frame.
+   *
+   * A QR code is found at any angle, so the frame does not have to be turned first.
+   */
+  @Synchronized
+  fun decode(luminance: ByteArray, width: Int, height: Int): Result? {
+    if (width <= 0 || height <= 0 || luminance.size < width * height) return null
+    val source = PlanarYUVLuminanceSource(luminance, width, height, 0, 0, width, height, false)
+    return decode(BinaryBitmap(HybridBinarizer(source)))
+  }
+
+  /** Decodes a picture. */
+  @Synchronized
+  fun decode(bitmap: Bitmap): Result? {
+    val width = bitmap.width
+    val height = bitmap.height
+    if (width <= 0 || height <= 0) return null
+    val pixels = IntArray(width * height)
+    bitmap.getPixels(pixels, 0, width, 0, 0, width, height)
+    val source = RGBLuminanceSource(width, height, pixels)
+    return decode(BinaryBitmap(HybridBinarizer(source)))
+  }
+
+  /**
+   * Decodes every barcode in a picture.
+   *
+   * The reader finds one barcode at a time, so each one it finds is blanked out before
+   * the next round.
+   */
+  @Synchronized
+  fun decodeAll(bitmap: Bitmap): List<BarCodeScannerResult> {
+    val width = bitmap.width
+    val height = bitmap.height
+    if (width <= 0 || height <= 0) return emptyList()
+    val pixels = IntArray(width * height)
+    bitmap.getPixels(pixels, 0, width, 0, 0, width, height)
+    val results = mutableListOf<BarCodeScannerResult>()
+    repeat(MAX_BARCODES_PER_PICTURE) {
+      val source = RGBLuminanceSource(width, height, pixels)
+      val result = decode(BinaryBitmap(HybridBinarizer(source))) ?: return results
+      results.add(toBarCodeScannerResult(result, width, height, 0))
+      if (!blankOut(pixels, width, height, result)) return results
+    }
+    return results
+  }
+
+  /** Clears the area a barcode covers, so the next round finds another one. */
+  private fun blankOut(pixels: IntArray, width: Int, height: Int, result: Result): Boolean {
+    val points = result.resultPoints ?: return false
+    if (points.isEmpty()) return false
+    var minX = points.minOf { it.x }
+    var maxX = points.maxOf { it.x }
+    var minY = points.minOf { it.y }
+    var maxY = points.maxOf { it.y }
+    // The finder patterns sit on the corners, so the area between them is the code.
+    val margin = maxOf(maxX - minX, maxY - minY) / 8 + 4
+    minX = maxOf(0f, minX - margin)
+    minY = maxOf(0f, minY - margin)
+    maxX = minOf((width - 1).toFloat(), maxX + margin)
+    maxY = minOf((height - 1).toFloat(), maxY + margin)
+    for (row in minY.toInt()..maxY.toInt()) {
+      for (column in minX.toInt()..maxX.toInt()) {
+        pixels[row * width + column] = 0xFFFFFFFF.toInt()
+      }
+    }
+    return true
+  }
+
+  private fun decode(bitmap: BinaryBitmap): Result? =
+    try {
+      reader.decodeWithState(bitmap)
+    } catch (_: NotFoundException) {
+      null
+    } catch (_: Exception) {
+      null
+    } finally {
+      reader.reset()
+    }
+
+  companion object {
+    /** How many barcodes one picture is searched for. */
+    private const val MAX_BARCODES_PER_PICTURE = 4
+
+    /**
+     * Turns a decoded barcode into the result the module reports.
+     *
+     * The corner points come out of the frame, so they are turned with it to match the
+     * upright picture the preview shows.
+     */
+    fun toBarCodeScannerResult(
+      result: Result,
+      imageWidth: Int,
+      imageHeight: Int,
+      rotationDegrees: Int
+    ): BarCodeScannerResult {
+      val cornerPoints = mutableListOf<Int>()
+      result.resultPoints?.forEach { point ->
+        val (x, y) = rotate(point.x, point.y, imageWidth, imageHeight, rotationDegrees)
+        cornerPoints.add(x)
+        cornerPoints.add(y)
+      }
+      val upright = rotationDegrees == 90 || rotationDegrees == 270
+      return BarCodeScannerResult(
+        type = BarcodeFormats.of(result.barcodeFormat),
+        value = result.text,
+        raw = result.rawBytes?.let { String(it) },
+        extra = BarCodeScannerResultSerializer.extraFor(result),
+        cornerPoints = cornerPoints,
+        height = if (upright) imageWidth else imageHeight,
+        width = if (upright) imageHeight else imageWidth
+      )
+    }
+
+    private fun rotate(x: Float, y: Float, width: Int, height: Int, degrees: Int): Pair<Int, Int> =
+      when (degrees) {
+        90 -> (height - 1 - y).toInt() to x.toInt()
+        180 -> (width - 1 - x).toInt() to (height - 1 - y).toInt()
+        270 -> y.toInt() to (width - 1 - x).toInt()
+        else -> x.toInt() to y.toInt()
+      }
+  }
+}
