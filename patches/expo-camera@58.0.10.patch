+package expo.modules.camera.analyzers
+
+import com.google.zxing.BarcodeFormat
+import com.google.zxing.qrcode.QRCodeWriter
+import java.nio.ByteBuffer
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+
+@RunWith(RobolectricTestRunner::class)
+class ZXingBarcodeReaderTest {
+  @Test
+  fun `a qr code in a frame is decoded`() {
+    val text = "https://app.t3.codes/pair?code=abc123"
+    val size = 240
+    val reader = ZXingBarcodeReader(setOf(BarcodeFormat.QR_CODE))
+
+    val result = reader.decode(qrLuminance(text, size), size, size)
+
+    assertNotNull(result)
+    assertEquals(text, result?.text)
+    assertEquals(BarcodeFormat.QR_CODE, result?.barcodeFormat)
+  }
+
+  @Test
+  fun `a qr code is found in a turned frame`() {
+    val text = "https://app.t3.codes/pair?code=abc123"
+    val size = 240
+    val reader = ZXingBarcodeReader(setOf(BarcodeFormat.QR_CODE))
+
+    val result = reader.decode(turn(qrLuminance(text, size), size), size, size)
+
+    assertEquals(text, result?.text)
+  }
+
+  @Test
+  fun `a frame without a code is not read as one`() {
+    val size = 240
+    val blank = ByteArray(size * size) { 0xFF.toByte() }
+    val reader = ZXingBarcodeReader(setOf(BarcodeFormat.QR_CODE))
+
+    assertEquals(null, reader.decode(blank, size, size))
+  }
+
+  @Test
+  fun `the code is reported with the type the javascript side expects`() {
+    val text = "https://app.t3.codes/pair?code=abc123"
+    val size = 240
+    val reader = ZXingBarcodeReader(setOf(BarcodeFormat.QR_CODE))
+    val result = reader.decode(qrLuminance(text, size), size, size)
+    assertNotNull(result)
+
+    val scanned = ZXingBarcodeReader.toBarCodeScannerResult(result!!, size, size, 0)
+
+    assertEquals(BarcodeFormats.QR_CODE, scanned.type)
+    assertEquals(text, scanned.value)
+    assertEquals(text, scanned.extra.getString("url"))
+    assertEquals(size, scanned.width)
+    assertEquals(size, scanned.height)
+  }
+
+  @Test
+  fun `the corner points are turned with the frame`() {
+    val text = "https://app.t3.codes/pair?code=abc123"
+    val size = 240
+    val reader = ZXingBarcodeReader(setOf(BarcodeFormat.QR_CODE))
+    val result = reader.decode(qrLuminance(text, size), size, size)
+    assertNotNull(result)
+
+    val upright = ZXingBarcodeReader.toBarCodeScannerResult(result!!, size, size, 0)
+    val turned = ZXingBarcodeReader.toBarCodeScannerResult(result, size, size, 90)
+
+    // A frame that is turned ninety degrees is reported in the picture the preview shows.
+    assertEquals(size, turned.width)
+    assertEquals(size, turned.height)
+    assertEquals(upright.cornerPoints.size, turned.cornerPoints.size)
+    assertNotEquals(upright.cornerPoints, turned.cornerPoints)
+  }
+
+  @Test
+  fun `a frame with a wider row is packed`() {
+    val width = 4
+    val height = 3
+    val rowStride = 6
+    val source = ByteArray(rowStride * height)
+    for (row in 0 until height) {
+      for (column in 0 until width) {
+        source[row * rowStride + column] = (row * width + column).toByte()
+      }
+    }
+
+    val packed = packLuminance(ByteBuffer.wrap(source), width, height, rowStride, 1)
+
+    val expected = ByteArray(width * height) { (it).toByte() }
+    assertArrayEquals(expected, packed)
+  }
+
+  @Test
+  fun `a frame that is cut short is not packed`() {
+    val packed = packLuminance(ByteBuffer.wrap(ByteArray(4)), 4, 4, 4, 1)
+
+    assertEquals(null, packed)
+  }
+
+  private fun assertNotEquals(unexpected: Any, actual: Any) {
+    org.junit.Assert.assertNotEquals(unexpected, actual)
+  }
+
+  private fun qrLuminance(text: String, size: Int): ByteArray {
+    val matrix = QRCodeWriter().encode(text, BarcodeFormat.QR_CODE, size, size)
+    val luminance = ByteArray(size * size)
+    for (row in 0 until size) {
+      for (column in 0 until size) {
+        luminance[row * size + column] = if (matrix.get(column, row)) 0 else 0xFF.toByte()
+      }
+    }
+    return luminance
+  }
+
+  private fun turn(luminance: ByteArray, size: Int): ByteArray {
+    val turned = ByteArray(size * size)
+    for (row in 0 until size) {
+      for (column in 0 until size) {
+        turned[column * size + (size - 1 - row)] = luminance[row * size + column]
+      }
+    }
+    return turned
+  }
+}
