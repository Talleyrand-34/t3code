+++ b/android/src/main/java/expo/modules/notifications/notifications/model/RemoteMessage.java
@@ -0,0 +1,513 @@
+package expo.modules.notifications.notifications.model;
+
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+/**
+ * A remote push message.
+ *
+ * This is a local stand-in for the Firebase Messaging {@code RemoteMessage} type. The
+ * Firebase Cloud Messaging transport is not part of this build, so nothing constructs a
+ * remote message from the network any more; the type stays because the notification
+ * pipeline still models a message that arrived from a push service.
+ */
+public class RemoteMessage implements Parcelable {
+  public static final int PRIORITY_UNSPECIFIED = -1;
+  public static final int PRIORITY_MIN = 1;
+  public static final int PRIORITY_LOW = 2;
+  public static final int PRIORITY_NORMAL = 3;
+  public static final int PRIORITY_HIGH = 4;
+  public static final int PRIORITY_MAX = 5;
+
+  private final Map<String, String> data;
+  private final Notification notification;
+  private final String messageId;
+  private final long sentTime;
+  private final int priority;
+  private final int originalPriority;
+  private final String collapseKey;
+  private final String from;
+  private final String messageType;
+  private final String to;
+  private final int ttl;
+
+  public RemoteMessage(
+    @Nullable Map<String, String> data,
+    @Nullable Notification notification,
+    @Nullable String messageId,
+    long sentTime,
+    int priority,
+    int originalPriority,
+    @Nullable String collapseKey,
+    @Nullable String from,
+    @Nullable String messageType,
+    @Nullable String to,
+    int ttl
+  ) {
+    this.data = data == null ? new HashMap<>() : data;
+    this.notification = notification;
+    this.messageId = messageId;
+    this.sentTime = sentTime;
+    this.priority = priority;
+    this.originalPriority = originalPriority;
+    this.collapseKey = collapseKey;
+    this.from = from;
+    this.messageType = messageType;
+    this.to = to;
+    this.ttl = ttl;
+  }
+
+  @NonNull
+  public Map<String, String> getData() {
+    return data;
+  }
+
+  @Nullable
+  public Notification getNotification() {
+    return notification;
+  }
+
+  @Nullable
+  public String getMessageId() {
+    return messageId;
+  }
+
+  public long getSentTime() {
+    return sentTime;
+  }
+
+  public int getPriority() {
+    return priority;
+  }
+
+  public int getOriginalPriority() {
+    return originalPriority;
+  }
+
+  @Nullable
+  public String getCollapseKey() {
+    return collapseKey;
+  }
+
+  @Nullable
+  public String getFrom() {
+    return from;
+  }
+
+  @Nullable
+  public String getMessageType() {
+    return messageType;
+  }
+
+  @Nullable
+  public String getTo() {
+    return to;
+  }
+
+  public int getTtl() {
+    return ttl;
+  }
+
+  @Override
+  public int describeContents() {
+    return 0;
+  }
+
+  @Override
+  public void writeToParcel(Parcel dest, int flags) {
+    dest.writeBundle(toBundle());
+  }
+
+  protected Bundle toBundle() {
+    Bundle bundle = new Bundle();
+    bundle.putBundle("data", toBundle(data));
+    bundle.putBundle("notification", notification == null ? null : notification.toBundle());
+    bundle.putString("messageId", messageId);
+    bundle.putLong("sentTime", sentTime);
+    bundle.putInt("priority", priority);
+    bundle.putInt("originalPriority", originalPriority);
+    bundle.putString("collapseKey", collapseKey);
+    bundle.putString("from", from);
+    bundle.putString("messageType", messageType);
+    bundle.putString("to", to);
+    bundle.putInt("ttl", ttl);
+    return bundle;
+  }
+
+  protected static Bundle toBundle(Map<String, String> data) {
+    Bundle serializedData = new Bundle();
+    for (Map.Entry<String, String> dataEntry : data.entrySet()) {
+      serializedData.putString(dataEntry.getKey(), dataEntry.getValue());
+    }
+    serializedData.putString("dataString", data.getOrDefault("body", null));
+    return serializedData;
+  }
+
+  public static final Creator<RemoteMessage> CREATOR = new Creator<RemoteMessage>() {
+    @Override
+    public RemoteMessage createFromParcel(Parcel in) {
+      Bundle bundle = in.readBundle(RemoteMessage.class.getClassLoader());
+      if (bundle == null) {
+        return new RemoteMessage(null, null, null, 0L, PRIORITY_UNSPECIFIED, PRIORITY_UNSPECIFIED, null, null, null, null, 0);
+      }
+      Bundle dataBundle = bundle.getBundle("data");
+      Map<String, String> data = new HashMap<>();
+      if (dataBundle != null) {
+        for (String key : dataBundle.keySet()) {
+          String value = dataBundle.getString(key);
+          if (value != null) {
+            data.put(key, value);
+          }
+        }
+      }
+      Notification notification = Notification.fromBundle(bundle.getBundle("notification"));
+      return new RemoteMessage(
+        data,
+        notification,
+        bundle.getString("messageId"),
+        bundle.getLong("sentTime"),
+        bundle.getInt("priority"),
+        bundle.getInt("originalPriority"),
+        bundle.getString("collapseKey"),
+        bundle.getString("from"),
+        bundle.getString("messageType"),
+        bundle.getString("to"),
+        bundle.getInt("ttl")
+      );
+    }
+
+    @Override
+    public RemoteMessage[] newArray(int size) {
+      return new RemoteMessage[size];
+    }
+  };
+
+  /**
+   * The notification payload of a remote message.
+   */
+  public static class Notification implements Parcelable {
+    @Nullable private final String body;
+    @Nullable private final String title;
+    @Nullable private final String sound;
+    @Nullable private final String color;
+    @Nullable private final String channelId;
+    @Nullable private final String icon;
+    @Nullable private final String tag;
+    @Nullable private final String ticker;
+    @Nullable private final String clickAction;
+    @Nullable private final String link;
+    @Nullable private final Uri imageUrl;
+    @Nullable private final Long eventTime;
+    @Nullable private final Integer notificationCount;
+    @Nullable private final Integer notificationPriority;
+    @Nullable private final Integer visibility;
+    @Nullable private final long[] vibrateTimings;
+    @Nullable private final int[] lightSettings;
+    @Nullable private final String[] bodyLocalizationArgs;
+    @Nullable private final String[] titleLocalizationArgs;
+    @Nullable private final String bodyLocalizationKey;
+    @Nullable private final String titleLocalizationKey;
+    private final boolean defaultLightSettings;
+    private final boolean defaultSound;
+    private final boolean defaultVibrateSettings;
+    private final boolean localOnly;
+    private final boolean sticky;
+    private final boolean usesDefaultLightSettings;
+
+    public Notification(
+      @Nullable String body,
+      @Nullable String title,
+      @Nullable String sound,
+      @Nullable String color,
+      @Nullable String channelId,
+      @Nullable String icon,
+      @Nullable String tag,
+      @Nullable String ticker,
+      @Nullable String clickAction,
+      @Nullable String link,
+      @Nullable Uri imageUrl,
+      @Nullable Long eventTime,
+      @Nullable Integer notificationCount,
+      @Nullable Integer notificationPriority,
+      @Nullable Integer visibility,
+      @Nullable long[] vibrateTimings,
+      @Nullable int[] lightSettings,
+      @Nullable String[] bodyLocalizationArgs,
+      @Nullable String[] titleLocalizationArgs,
+      @Nullable String bodyLocalizationKey,
+      @Nullable String titleLocalizationKey,
+      boolean defaultLightSettings,
+      boolean defaultSound,
+      boolean defaultVibrateSettings,
+      boolean localOnly,
+      boolean sticky
+    ) {
+      this.body = body;
+      this.title = title;
+      this.sound = sound;
+      this.color = color;
+      this.channelId = channelId;
+      this.icon = icon;
+      this.tag = tag;
+      this.ticker = ticker;
+      this.clickAction = clickAction;
+      this.link = link;
+      this.imageUrl = imageUrl;
+      this.eventTime = eventTime;
+      this.notificationCount = notificationCount;
+      this.notificationPriority = notificationPriority;
+      this.visibility = visibility;
+      this.vibrateTimings = vibrateTimings;
+      this.lightSettings = lightSettings;
+      this.bodyLocalizationArgs = bodyLocalizationArgs;
+      this.titleLocalizationArgs = titleLocalizationArgs;
+      this.bodyLocalizationKey = bodyLocalizationKey;
+      this.titleLocalizationKey = titleLocalizationKey;
+      this.defaultLightSettings = defaultLightSettings;
+      this.defaultSound = defaultSound;
+      this.defaultVibrateSettings = defaultVibrateSettings;
+      this.localOnly = localOnly;
+      this.sticky = sticky;
+      this.usesDefaultLightSettings = defaultLightSettings;
+    }
+
+    @Nullable
+    public String getBody() {
+      return body;
+    }
+
+    @Nullable
+    public String getTitle() {
+      return title;
+    }
+
+    @Nullable
+    public String getSound() {
+      return sound;
+    }
+
+    @Nullable
+    public String getColor() {
+      return color;
+    }
+
+    @Nullable
+    public String getChannelId() {
+      return channelId;
+    }
+
+    @Nullable
+    public String getIcon() {
+      return icon;
+    }
+
+    @Nullable
+    public String getTag() {
+      return tag;
+    }
+
+    @Nullable
+    public String getTicker() {
+      return ticker;
+    }
+
+    @Nullable
+    public String getClickAction() {
+      return clickAction;
+    }
+
+    @Nullable
+    public String getLink() {
+      return link;
+    }
+
+    @Nullable
+    public Uri getImageUrl() {
+      return imageUrl;
+    }
+
+    @Nullable
+    public Long getEventTime() {
+      return eventTime;
+    }
+
+    @Nullable
+    public Integer getNotificationCount() {
+      return notificationCount;
+    }
+
+    @Nullable
+    public Integer getNotificationPriority() {
+      return notificationPriority;
+    }
+
+    @Nullable
+    public Integer getVisibility() {
+      return visibility;
+    }
+
+    @Nullable
+    public long[] getVibrateTimings() {
+      return vibrateTimings;
+    }
+
+    @Nullable
+    public int[] getLightSettings() {
+      return lightSettings;
+    }
+
+    @Nullable
+    public String[] getBodyLocalizationArgs() {
+      return bodyLocalizationArgs;
+    }
+
+    @Nullable
+    public String[] getTitleLocalizationArgs() {
+      return titleLocalizationArgs;
+    }
+
+    @Nullable
+    public String getBodyLocalizationKey() {
+      return bodyLocalizationKey;
+    }
+
+    @Nullable
+    public String getTitleLocalizationKey() {
+      return titleLocalizationKey;
+    }
+
+    public boolean getDefaultLightSettings() {
+      return defaultLightSettings;
+    }
+
+    public boolean getDefaultSound() {
+      return defaultSound;
+    }
+
+    public boolean getDefaultVibrateSettings() {
+      return defaultVibrateSettings;
+    }
+
+    public boolean getLocalOnly() {
+      return localOnly;
+    }
+
+    public boolean getSticky() {
+      return sticky;
+    }
+
+    public boolean getUsesDefaultLightSettings() {
+      return usesDefaultLightSettings;
+    }
+
+    @Override
+    public int describeContents() {
+      return 0;
+    }
+
+    @Override
+    public void writeToParcel(Parcel dest, int flags) {
+      dest.writeBundle(toBundle());
+    }
+
+    Bundle toBundle() {
+      Bundle bundle = new Bundle();
+      bundle.putString("body", body);
+      bundle.putString("title", title);
+      bundle.putString("sound", sound);
+      bundle.putString("color", color);
+      bundle.putString("channelId", channelId);
+      bundle.putString("icon", icon);
+      bundle.putString("tag", tag);
+      bundle.putString("ticker", ticker);
+      bundle.putString("clickAction", clickAction);
+      bundle.putString("link", link);
+      bundle.putString("imageUrl", imageUrl == null ? null : imageUrl.toString());
+      if (eventTime != null) {
+        bundle.putLong("eventTime", eventTime);
+      }
+      if (notificationCount != null) {
+        bundle.putInt("notificationCount", notificationCount);
+      }
+      if (notificationPriority != null) {
+        bundle.putInt("notificationPriority", notificationPriority);
+      }
+      if (visibility != null) {
+        bundle.putInt("visibility", visibility);
+      }
+      bundle.putLongArray("vibrateTimings", vibrateTimings);
+      bundle.putIntArray("lightSettings", lightSettings);
+      bundle.putStringArray("bodyLocalizationArgs", bodyLocalizationArgs);
+      bundle.putStringArray("titleLocalizationArgs", titleLocalizationArgs);
+      bundle.putString("bodyLocalizationKey", bodyLocalizationKey);
+      bundle.putString("titleLocalizationKey", titleLocalizationKey);
+      bundle.putBoolean("defaultLightSettings", defaultLightSettings);
+      bundle.putBoolean("defaultSound", defaultSound);
+      bundle.putBoolean("defaultVibrateSettings", defaultVibrateSettings);
+      bundle.putBoolean("localOnly", localOnly);
+      bundle.putBoolean("sticky", sticky);
+      bundle.putBoolean("usesDefaultLightSettings", usesDefaultLightSettings);
+      return bundle;
+    }
+
+    static Notification fromBundle(@Nullable Bundle bundle) {
+      if (bundle == null) {
+        return null;
+      }
+      Uri imageUrl = null;
+      String imageUrlString = bundle.getString("imageUrl");
+      if (imageUrlString != null) {
+        imageUrl = Uri.parse(imageUrlString);
+      }
+      return new Notification(
+        bundle.getString("body"),
+        bundle.getString("title"),
+        bundle.getString("sound"),
+        bundle.getString("color"),
+        bundle.getString("channelId"),
+        bundle.getString("icon"),
+        bundle.getString("tag"),
+        bundle.getString("ticker"),
+        bundle.getString("clickAction"),
+        bundle.getString("link"),
+        imageUrl,
+        bundle.containsKey("eventTime") ? bundle.getLong("eventTime") : null,
+        bundle.containsKey("notificationCount") ? bundle.getInt("notificationCount") : null,
+        bundle.containsKey("notificationPriority") ? bundle.getInt("notificationPriority") : null,
+        bundle.containsKey("visibility") ? bundle.getInt("visibility") : null,
+        bundle.getLongArray("vibrateTimings"),
+        bundle.getIntArray("lightSettings"),
+        bundle.getStringArray("bodyLocalizationArgs"),
+        bundle.getStringArray("titleLocalizationArgs"),
+        bundle.getString("bodyLocalizationKey"),
+        bundle.getString("titleLocalizationKey"),
+        bundle.getBoolean("defaultLightSettings"),
+        bundle.getBoolean("defaultSound"),
+        bundle.getBoolean("defaultVibrateSettings"),
+        bundle.getBoolean("localOnly"),
+        bundle.getBoolean("sticky")
+      );
+    }
+
+    public static final Creator<Notification> CREATOR = new Creator<Notification>() {
+      @Override
+      public Notification createFromParcel(Parcel in) {
+        Bundle bundle = in.readBundle(Notification.class.getClassLoader());
+        return fromBundle(bundle);
+      }
+
+      @Override
+      public Notification[] newArray(int size) {
+        return new Notification[size];
+      }
+    };
+  }
+}
